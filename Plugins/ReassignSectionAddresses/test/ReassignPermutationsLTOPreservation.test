# REQUIRES: hexagon, llvm-readelf, llvm-objdump
# Negative control: compile-time -Wa alone does not configure LTO codegen.
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clang --compiler-flags="%clangopts" --language c --case lto-preservation --link %link --readelf %readelf --objdump %objdump --work %t.c.dir
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clangxx --compiler-flags="%clangxxopts" --language c++ --case lto-preservation --link %link --readelf %readelf --objdump %objdump --work %t.cxx.dir
