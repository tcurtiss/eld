# REQUIRES: hexagon, llvm-readelf, llvm-objdump
# C/C++ native code generation, CPU, small-data and constant merging.
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clang --compiler-flags="%clangopts" --language c --case compiler --link %link --readelf %readelf --objdump %objdump --work %t.c.dir
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clangxx --compiler-flags="%clangxxopts" --language c++ --case compiler --link %link --readelf %readelf --objdump %objdump --work %t.cxx.dir
