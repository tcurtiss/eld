# REQUIRES: hexagon, llvm-readelf, llvm-objdump, llvm-ar
# Negative control: a mixed archive still needs symbol-preserving recompilation.
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clang --compiler-flags="%clangopts" --language c --case legacy-archive --link %link --readelf %readelf --objdump %objdump --ar %ar --work %t.c.dir
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clangxx --compiler-flags="%clangxxopts" --language c++ --case legacy-archive --link %link --readelf %readelf --objdump %objdump --ar %ar --work %t.cxx.dir
