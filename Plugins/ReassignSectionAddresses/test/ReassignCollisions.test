# REQUIRES: llvm-readelf
# Real collisions in 32-bit digest slices, within/across sections, excluded
# alternatives, exhaustion and duplicate reuse after sequential wrap.
RUN: %python %p/Inputs/check_collisions.py --compiler %clang --compiler-flags="%clangopts" --link %link --readelf %readelf --work %t
