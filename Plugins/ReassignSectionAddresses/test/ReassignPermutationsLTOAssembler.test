# REQUIRES: hexagon, llvm-readelf, llvm-objdump, llvm-mc
# Cover explicit symbol preservation with the external LTO assembler.
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clang --compiler-flags="%clangopts" --language c --case lto-asm --link %link --readelf %readelf --objdump %objdump --work %t.c.dir
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clangxx --compiler-flags="%clangxxopts" --language c++ --case lto-asm --link %link --readelf %readelf --objdump %objdump --work %t.cxx.dir
