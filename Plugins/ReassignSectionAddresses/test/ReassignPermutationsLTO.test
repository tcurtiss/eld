# REQUIRES: hexagon, llvm-readelf, llvm-objdump
# Full and Thin LTO support explicit preservation during link-time codegen.
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clang --compiler-flags="%clangopts" --language c --case lto --link %link --readelf %readelf --objdump %objdump --work %t.c.dir
RUN: %python %p/Inputs/check_address_permutations.py --compiler %clangxx --compiler-flags="%clangxxopts" --language c++ --case lto --link %link --readelf %readelf --objdump %objdump --work %t.cxx.dir
