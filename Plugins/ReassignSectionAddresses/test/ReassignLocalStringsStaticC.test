# REQUIRES: hexagon, llvm-readelf, llvm-objdump
# Fixed-address C executables from -fno-pic, -fpic and -fPIC objects.
RUN: %python %p/Inputs/check_address_patterns.py --compiler %clang --compiler-flags="%clangopts" --language c --mode static --link %link --readelf %readelf --objdump %objdump --work %t.dir
