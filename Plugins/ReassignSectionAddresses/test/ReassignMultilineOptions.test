# REQUIRES: llvm-readelf
# Exercise actual ELD YAML parsing, not just synthetic plugin option strings.
RUN: %python %p/Inputs/check_multiline_options.py --compiler %clang --compiler-flags="%clangopts" --link %link --link-flags="%linkopts" --readelf %readelf --work %t
