# REQUIRES: llvm-readelf
# Range syntax, inclusive bounds, digest-slice fallback, wraparound and outputs.
RUN: %python %p/Inputs/check_exclude_ranges.py --compiler %clang --compiler-flags="%clangopts" --link %link --readelf %readelf --work %t
