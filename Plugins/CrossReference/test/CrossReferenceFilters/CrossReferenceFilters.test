DUMP-EXCLUDE-LOCAL: # Edges: <src-id>{{[[:space:]]}}<dst-id>{{[[:space:]]}}<count>{{[[:space:]]}}<flags>
DUMP-EXCLUDE-LOCAL-DAG: [[C1]]{{[[:space:]]}}[[LC]]{{[[:space:]]}}{{[0-9]+}}{{[[:space:]]}}-
DUMP-EXCLUDE-LOCAL-DAG: [[LM]]{{[[:space:]]}}[[C1]]{{[[:space:]]}}{{[0-9]+}}{{[[:space:]]}}-

