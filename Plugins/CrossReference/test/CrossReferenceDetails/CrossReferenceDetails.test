# Plain -g, C++ linkage names, variables, local symbols, aliases, multiple symbols
# per section, unchanged lightweight graph, optional metadata and deterministic
# serial/parallel JSON. All paths and link invocations are target-independent.
RUN: %python %p/check.py configs %t
RUN: %clangxx %clangopts -g -O0 -fno-inline -fno-exceptions -fno-rtti -c %p/Inputs/a.cpp -o %t/a.o
RUN: %clang %clangopts -g -O0 -c %p/Inputs/b.c -o %t/b.o
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/plain.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/detail.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/nodwarf.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/filtered.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/dwarf.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/columnar.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/gzip.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/strip.yaml
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/demangled.yaml
RUN: %link %linkopts --no-threads %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/dwarf.yaml
RUN: cp %t/dwarf.json %t/serial.json
RUN: %link %linkopts --threads --thread-count 4 %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/dwarf.yaml
RUN: %python %p/check.py check %t
RUN: %clangxx %clangopts -gdwarf-4 -O0 -fno-inline -fno-exceptions -fno-rtti -c %p/Inputs/a.cpp -o %t/a.o
RUN: %clang %clangopts -gdwarf-4 -O0 -c %p/Inputs/b.c -o %t/b.o
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/dwarf.yaml
RUN: %python %p/check.py compare %t/dwarf.json %t/serial.json
RUN: %clangxx %clangopts -gdwarf-5 -O0 -fno-inline -fno-exceptions -fno-rtti -c %p/Inputs/a.cpp -o %t/a.o
RUN: %clang %clangopts -gdwarf-5 -O0 -c %p/Inputs/b.c -o %t/b.o
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/dwarf.yaml
RUN: %python %p/check.py compare %t/dwarf.json %t/serial.json
RUN: %clangxx %clangopts -g -O0 -ffunction-sections -fdata-sections -fno-exceptions -fno-rtti -c %p/Inputs/a.cpp -o %t/a.o
RUN: %clang %clangopts -g -O0 -ffunction-sections -fdata-sections -c %p/Inputs/b.c -o %t/b.o
RUN: %link %linkopts --gc-sections %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/dwarf.yaml
RUN: %python %p/check.py gc %t
RUN: %not %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/invalid.yaml 2>&1 | %filecheck %s
# CHECK: symbol_details option must be 'yes' or 'no'
RUN: %not %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/invalid_dwarf.yaml 2>&1 | %filecheck %s --check-prefix=INVALID-DWARF
# INVALID-DWARF: use_dwarf option must be 'yes' or 'no'
RUN: %not %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/old_dwarf.yaml 2>&1 | %filecheck %s --check-prefix=OLD-DWARF
# OLD-DWARF: CrossReference does not recognize option 'usedwarf'
RUN: %clangxx %clangopts -O0 -fno-exceptions -fno-rtti -c %p/Inputs/a.cpp -o %t/a.o
RUN: %clang %clangopts -O0 -c %p/Inputs/b.c -o %t/b.o
RUN: %link %linkopts %t/a.o %t/b.o -e entry -o %t/out --plugin-config %t/dwarf.yaml
RUN: %python %p/check.py missing %t
