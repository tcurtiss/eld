#---CrossReferenceDWARF.test----------------- Executable,LS --------------------#
#BEGIN_COMMENT
# Tests the CrossReference's usedwarf option: with usedwarf=yes, each
# symbol in the dump is additionally qualified with its declaring source
# file and line number, as recovered from DWARF debug info (in text format,
# appended to the symbol name as "(source-file:line)"). By default (usedwarf unset),
# no such information is looked up or
# printed, exactly as before this option existed.
#
# The input is compiled with "-gdwarf-2 -mllvm -dwarf-inlined-strings=Enable"
# rather than a plain "-g": ELD's DWARF plugin API parses each input file's
# debug sections directly from its own unrelocated bytes, so a name stored
# via a relocated string form (DW_FORM_strp/DW_FORM_strx, the default for
# DW_AT_name/DW_AT_decl_file with plain "-g" on most targets) resolves
# incorrectly, since the relocation that would point it at the right
# .debug_str/.debug_str_offsets entry is never applied to non-alloc debug
# sections during linking. Forcing inlined (non-relocated) debug strings
# avoids this and lets the test exercise correct DWARF lookup.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t1.1.o -ffunction-sections -fdata-sections -gdwarf-2 -mllvm -dwarf-inlined-strings=Enable
RUN: rm -f xref_dump.txt
RUN: %link %linkopts %t1.1.o -e main -o %t1.out --plugin-config %p/Inputs/PluginConfig.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_dump.txt %s --check-prefix=DUMP-NODWARF
RUN: rm -f xref_dump.txt
RUN: %link %linkopts %t1.1.o -e main -o %t2.out --plugin-config %p/Inputs/PluginConfigUseDWARF.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_dump.txt %s --check-prefix=DUMP-DWARF
RUN: rm -f xref_dump.txt
RUN: %link %linkopts %t1.1.o -e main -o %t3.out --plugin-config %p/Inputs/PluginConfigUseDWARFSourceRoot.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_dump.txt %s --check-prefix=DUMP-DWARF-ROOT
RUN: rm -f xref_dump.txt
#END_TEST

LINK-NOT: Error

DUMP-NODWARF: # Symbols: <id>{{[[:space:]]}}<name>{{[[:space:]]}}<file>{{[[:space:]]}}0x<size>{{[[:space:]]}}<address>{{[[:space:]]}}<output-section>
DUMP-NODWARF-DAG: foo{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-NODWARF-DAG: bar{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-NODWARF-DAG: main{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-NODWARF-DAG: global_data{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-NODWARF-NOT: 1.c
DUMP-NODWARF: # Edges: <src-id>{{[[:space:]]}}<dst-id>{{[[:space:]]}}<count>{{[[:space:]]}}<flags>

DUMP-DWARF: # Symbols: <id>{{[[:space:]]}}<name>{{[[:space:]]}}<file>{{[[:space:]]}}0x<size>{{[[:space:]]}}<address>{{[[:space:]]}}<output-section>
DUMP-DWARF: #   with usedwarf=yes, source appears after the name as (file:line).
DUMP-DWARF-DAG: foo ({{.*}}1.c:2){{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DWARF-DAG: bar ({{.*}}1.c:3){{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DWARF-DAG: main ({{.*}}1.c:4){{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DWARF-DAG: global_data ({{.*}}1.c:1){{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DWARF: # Edges: <src-id>{{[[:space:]]}}<dst-id>{{[[:space:]]}}<count>{{[[:space:]]}}<flags>

DUMP-DWARF-ROOT: # Symbols: <id>{{[[:space:]]}}<name>{{[[:space:]]}}<file>{{[[:space:]]}}0x<size>{{[[:space:]]}}<address>{{[[:space:]]}}<output-section>
DUMP-DWARF-ROOT-DAG: foo ({{.*}}1.c:2){{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DWARF-ROOT-NOT: (/
