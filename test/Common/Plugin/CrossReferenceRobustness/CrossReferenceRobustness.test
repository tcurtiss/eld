#---CrossReferenceRobustness.test------------- Executable,LS --------------------#
#BEGIN_COMMENT
# Exercises CrossReference defaults, option diagnostics, symbol/edge filtering,
# exact attribution, repeated-reference counts,
# dashboard garbage-collection behavior, columnar invariants, KEEP roots,
# empty graphs, and output-file failures.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t1.o -ffunction-sections -fdata-sections -fno-inline
RUN: %clang %clangopts -c %p/Inputs/2.c -o %t2.o -ffunction-sections -fdata-sections -fno-inline
RUN: %clang %clangopts -emit-llvm -c %p/Inputs/2.c -o %t2.bc

RUN: rm -f xref_robust.txt
RUN: %link %linkopts %t1.o %t2.bc -e main -o %tbitcode.out --plugin-config %p/Inputs/PluginConfigDefault.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_robust.txt %s --check-prefix=BITCODE

RUN: rm -f xref_robust.txt
RUN: %link %linkopts %t1.o %t2.o -e main -o %t1.out --plugin-config %p/Inputs/PluginConfigDefault.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_robust.txt %s --check-prefix=DUMP-DEFAULT

RUN: rm -f xref_robust.txt
RUN: %link %linkopts %t1.o %t2.o -e main -o %t2.out --plugin-config %p/Inputs/PluginConfigIncludeExclude.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_robust.txt %s --check-prefix=DUMP-INCLUDE-EXCLUDE

RUN: rm -f xref_robust.txt
RUN: %link %linkopts %t1.o %t2.o -e main -o %t3.out --plugin-config %p/Inputs/PluginConfigMinRefs.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_robust.txt %s --check-prefix=DUMP-MIN-REFS

RUN: rm -f xref_robust.txt
RUN: %link %linkopts %t1.o %t2.o -e main -o %t4.out --plugin-config %p/Inputs/PluginConfigCrossFile.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_robust.txt %s --check-prefix=DUMP-CROSS-FILE

RUN: rm -f xref_robust.txt
RUN: %link %linkopts %t1.o %t2.o -e main -o %t5.out --plugin-config %p/Inputs/PluginConfigExcludeFunctions.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_robust.txt %s --check-prefix=DUMP-EXCLUDE-FUNCTIONS

RUN: rm -f xref_robust.txt
RUN: %link %linkopts %t1.o %t2.o -e main -o %t6.out --plugin-config %p/Inputs/PluginConfigExcludeData.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_robust.txt %s --check-prefix=DUMP-EXCLUDE-DATA

RUN: rm -f xref_robust.json
RUN: %link %linkopts --gc-sections %t1.o %t2.o -e main -o %t8.out --plugin-config %p/Inputs/PluginConfigJSONGC.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %python -c "import json; d=json.load(open('xref_robust.json')); ns=d['nodes']; ids={n['name']:n['id'] for n in ns}; print('JSON-GC', 'local_fn' in ids, 'unused' in ids, next(n.get('live', True) is False for n in ns if n['name']=='unused')); print('JSON-COUNT', any(ns[e['src']]['name']=='caller' and ns[e['dst']]['name']=='target' and e['count']==2 for e in d['edges']))" | %filecheck %s --check-prefix=JSON-GC

RUN: rm -f xref_robust_columnar.json
RUN: %link %linkopts --gc-sections %t1.o %t2.o -e main -o %t9.out --plugin-config %p/Inputs/PluginConfigColumnarGC.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %python -c "import json; d=json.load(open('xref_robust_columnar.json')); s=d['sections']; names=s['name']; print('COLUMNAR-SHAPE', len(s['size'])==s['count'], len(s['file'])==s['count'], len(d['refs']['offsets'])==s['count']+1); print('COLUMNAR-GC', 'local_fn' in names, any(n=='unused' and (f & 1) for n,f in zip(names,s['flags']))); print('COLUMNAR-COUNT', any(names[src]=='caller' and names[dst]=='target' and c==2 for src in range(s['count']) for j,c in enumerate(d['refs']['counts'][d['refs']['offsets'][src]:d['refs']['offsets'][src+1]]) for dst in [d['refs']['targets'][d['refs']['offsets'][src]+j]]))" | %filecheck %s --check-prefix=COLUMNAR

RUN: rm -f xref_keep.json
RUN: %link %linkopts --gc-sections %t1.o %t2.o -T %p/Inputs/keep.t -e main -o %t10.out --plugin-config %p/Inputs/PluginConfigJSONKeep.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %python -c "import json; d=json.load(open('xref_keep.json')); ns={n['name']:n for n in d['nodes']}; print('KEEP-ROOT', ns['kept'].get('root', False), ns['unused'].get('live', True) is False)" | %filecheck %s --check-prefix=KEEP

RUN: rm -f xref_path.json
RUN: %link %linkopts %t1.o %t2.o -e main -o %tpath.out --plugin-config %p/Inputs/PluginConfigSourceRootNoMatch.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %python -c "import json; d=json.load(open('xref_path.json')); print('SOURCE-ROOT-BOUNDARY', all(n['path'].startswith('/') for n in d['nodes']))" | %filecheck %s --check-prefix=PATH

RUN: %clang %clangopts -c %p/Inputs/no_references.c -o %tnoref.o -ffunction-sections
RUN: echo stale > xref_norefs.txt
RUN: %link %linkopts %tnoref.o -e main -o %t11.out --plugin-config %p/Inputs/PluginConfigNoRefs.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_norefs.txt %s --check-prefix=NO-REFS

RUN: %not %link %linkopts %t1.o -e main -o %t12.out --plugin-config %p/Inputs/PluginConfigNoFile.yaml 2>&1 | %filecheck %s --check-prefix=NO-FILE
RUN: %not %link %linkopts %t1.o -e main -o %t13.out --plugin-config %p/Inputs/PluginConfigDuplicateFile.yaml 2>&1 | %filecheck %s --check-prefix=DUPLICATE-FILE
RUN: %not %link %linkopts %t1.o -e main -o %t14.out --plugin-config %p/Inputs/PluginConfigMalformedToken.yaml 2>&1 | %filecheck %s --check-prefix=MALFORMED-TOKEN
RUN: %not %link %linkopts %t1.o -e main -o %t15.out --plugin-config %p/Inputs/PluginConfigUnknownOption.yaml 2>&1 | %filecheck %s --check-prefix=UNKNOWN-OPTION
RUN: %not %link %linkopts %t1.o -e main -o %t16.out --plugin-config %p/Inputs/PluginConfigInvalidYesNo.yaml 2>&1 | %filecheck %s --check-prefix=INVALID-YESNO
RUN: %not %link %linkopts %t1.o -e main -o %t17.out --plugin-config %p/Inputs/PluginConfigInvalidNumber.yaml 2>&1 | %filecheck %s --check-prefix=INVALID-NUMBER
RUN: %not %link %linkopts %t1.o -e main -o %t18.out --plugin-config %p/Inputs/PluginConfigConflictingPaths.yaml 2>&1 | %filecheck %s --check-prefix=CONFLICTING-PATHS
RUN: %not %link %linkopts %t1.o -e main -o %t19.out --plugin-config %p/Inputs/PluginConfigInvalidStripGlob.yaml 2>&1 | %filecheck %s --check-prefix=INVALID-STRIP
RUN: %not %link %linkopts %t1.o %t2.o -e main -o %t20.out --plugin-config %p/Inputs/PluginConfigOutputFailure.yaml 2>&1 | %filecheck %s --check-prefix=OUTPUT-FAILURE
RUN: rm -f xref_robust.txt xref_robust.json xref_robust_columnar.json xref_keep.json xref_path.json xref_norefs.txt
#END_TEST

LINK-NOT: Error

BITCODE: # Symbols: <id>{{[[:space:]]}}<name>{{[[:space:]]}}<file>{{[[:space:]]}}0x<size>{{[[:space:]]}}<address>{{[[:space:]]}}<output-section>

DUMP-DEFAULT: # Symbols: <id>{{[[:space:]]}}<name>{{[[:space:]]}}<file>{{[[:space:]]}}0x<size>{{[[:space:]]}}<address>{{[[:space:]]}}<output-section>
DUMP-DEFAULT-DAG: [[CALLER:[0-9]+]]{{[[:space:]]}}caller{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DEFAULT-DAG: [[TARGET:[0-9]+]]{{[[:space:]]}}target{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DEFAULT-DAG: [[REMOTE:[0-9]+]]{{[[:space:]]}}remote{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DEFAULT-DAG: [[SELF:[0-9]+]]{{[[:space:]]}}self_ref{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DEFAULT-DAG: [[PTR:[0-9]+]]{{[[:space:]]}}global_ptr{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DEFAULT-DAG: [[GLOBAL:[0-9]+]]{{[[:space:]]}}global_data{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DEFAULT-DAG: common_data{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DEFAULT-NOT: local_fn
DUMP-DEFAULT-NOT: local_data
DUMP-DEFAULT: # Edges: <src-id>{{[[:space:]]}}<dst-id>{{[[:space:]]}}<count>{{[[:space:]]}}<flags>
DUMP-DEFAULT: [[CALLER]]{{[[:space:]]}}[[TARGET]]{{[[:space:]]}}2{{[[:space:]]}}-
DUMP-DEFAULT: [[SELF]]{{[[:space:]]}}[[SELF]]{{[[:space:]]}}1{{[[:space:]]}}-
DUMP-DEFAULT: [[PTR]]{{[[:space:]]}}[[GLOBAL]]{{[[:space:]]}}1{{[[:space:]]}}-

DUMP-INCLUDE-EXCLUDE: # Symbols:
DUMP-INCLUDE-EXCLUDE: caller
DUMP-INCLUDE-EXCLUDE-NOT: target
DUMP-INCLUDE-EXCLUDE-NOT: main

DUMP-MIN-REFS: # Symbols:
DUMP-MIN-REFS: target
DUMP-MIN-REFS-NOT: caller
DUMP-MIN-REFS-NOT: main

DUMP-CROSS-FILE: # Symbols:
DUMP-CROSS-FILE-DAG: caller
DUMP-CROSS-FILE-DAG: target
DUMP-CROSS-FILE-DAG: remote
DUMP-CROSS-FILE: # Edges:
DUMP-CROSS-FILE: {{[0-9]+}}{{[[:space:]]}}{{[0-9]+}}{{[[:space:]]}}1{{[[:space:]]}}-

DUMP-EXCLUDE-FUNCTIONS: # Symbols:
DUMP-EXCLUDE-FUNCTIONS: global_data
DUMP-EXCLUDE-FUNCTIONS-NOT: caller
DUMP-EXCLUDE-FUNCTIONS-NOT: target

DUMP-EXCLUDE-DATA: # Symbols:
DUMP-EXCLUDE-DATA: local_fn
DUMP-EXCLUDE-DATA: target
DUMP-EXCLUDE-DATA-NOT: global_data

JSON-GC: JSON-GC True True True
JSON-GC: JSON-COUNT True
COLUMNAR: COLUMNAR-SHAPE True True True
COLUMNAR: COLUMNAR-GC True True
COLUMNAR: COLUMNAR-COUNT True
KEEP: KEEP-ROOT True True
PATH: SOURCE-ROOT-BOUNDARY True
NO-REFS: # Edges: <src-id>{{[[:space:]]}}<dst-id>{{[[:space:]]}}<count>{{[[:space:]]}}<flags>
NO-REFS-NOT: stale
NO-REFS-NOT: {{^[0-9-]+[[:space:]]+[0-9]+[[:space:]]+[0-9]+}}

NO-FILE: CrossReference requires a 'file=<path>' option
DUPLICATE-FILE: CrossReference was given more than one 'file' option
MALFORMED-TOKEN: CrossReference does not recognize option 'show_gc': options must be in key=value form
UNKNOWN-OPTION: CrossReference does not recognize option 'not_an_option'
INVALID-YESNO: CrossReference's show_gc option must be 'yes' or 'no'
INVALID-NUMBER: CrossReference's min_refs option must be a non-negative integer
CONFLICTING-PATHS: CrossReference options 'source_root' and 'strip_prefix' are mutually exclusive
INVALID-STRIP: CrossReference could not parse strip_prefix glob pattern '[unterminated'
OUTPUT-FAILURE: CrossReference could not open dump file '/definitely/missing/crossreference/output/xref.txt' for writing
