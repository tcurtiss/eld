UNSUPPORTED: riscv64
#---ReassignSectionAddressesBinding.test---------- Executable,LS ----------------#
#BEGIN_COMMENT
# Tests that a global, a weak, and a local symbol each retain their original
# binding after their address is reassigned to an absolute value --
# setSymbolAddress() only clears the symbol's FragmentRef (which is what
# makes it emit as SHN_ABS) and must not also force its binding to global,
# since a symbol's ELF binding (STB_LOCAL/GLOBAL/WEAK) and its section index
# (e.g. SHN_ABS) are independent attributes.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/3.c -o %t3.3.o -ffunction-sections -fdata-sections
RUN: %link %linkopts %t3.3.o -T %p/Inputs/script.t -o %t15.out --plugin-config %p/Inputs/plugin.config -L %p/Inputs 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %nm %t15.out | %filecheck %s --check-prefix=NM-BINDING
#LINK-NOT: overlaps
#LINK-NOT: not in any load segment
#NM-BINDING: {{0*}}f856ee2d A gsym
#NM-BINDING: {{0*}}b3951bf1 a lsym
#NM-BINDING: {{0*}}4c5e57f7 V wsym
#END_TEST
