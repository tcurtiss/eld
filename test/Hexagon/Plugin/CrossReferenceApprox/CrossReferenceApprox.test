#---CrossReferenceApprox.test------------------ Executable,LS --------------------#
#BEGIN_COMMENT
# Tests the CrossReference's nearest-preceding-symbol fallback: when a
# chunk's symbols have no reliable size information (here, hand-written
# assembly with no .size directives, so every symbol has size 0), a
# relocation site can never fall inside any symbol's [offset, offset+size)
# range. The plugin should still attribute the reference to the nearest
# preceding symbol by offset, and mark the edge with the "approx" flag.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.s -o %t1.1.o
RUN: rm -f xref_approx_dump.txt
RUN: %link %linkopts %t1.1.o -e foo -o %t1.out --plugin-config %p/Inputs/PluginConfig.yaml 2>&1 | %filecheck %s --check-prefix=LINK --allow-empty
RUN: %filecheck <xref_approx_dump.txt %s --check-prefix=DUMP
RUN: rm -f xref_approx_dump.txt
#END_TEST

LINK-NOT: Error

DUMP: # Symbols: <id>{{[[:space:]]}}<name>{{[[:space:]]}}<file>{{[[:space:]]}}0x<size>{{[[:space:]]}}<address>{{[[:space:]]}}<output-section>
DUMP-DAG: [[FOO:[0-9]+]]{{[[:space:]]}}foo{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP-DAG: [[BAR:[0-9]+]]{{[[:space:]]}}bar{{[[:space:]]}}{{.*}}{{[[:space:]]}}0x{{[0-9a-f]+}}{{[[:space:]]}}0x{{[0-9a-f]+}}
DUMP: # Edges: <src-id>{{[[:space:]]}}<dst-id>{{[[:space:]]}}<count>{{[[:space:]]}}<flags>
DUMP: [[FOO]]{{[[:space:]]}}[[BAR]]{{[[:space:]]}}1{{[[:space:]]}}approx
